# Operations console vhost. Same allow list as the API, and a tighter one is better: the
# console is for named staff, the API is for the banking service.
#
# The console cannot be made read only here. It signs in as a Fineract user, so what an
# operator can do is decided by that user's Fineract role. See
# deploy/docs/runbooks/service-account.md.

server {
    listen 80;
    server_name ${CONSOLE_HOST};
    location /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${CONSOLE_HOST};

    ssl_certificate     /etc/letsencrypt/live/${CONSOLE_HOST}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${CONSOLE_HOST}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;

    if ($cbs_allowed = 0) { return 403; }

    access_log /var/log/nginx/cbs-console-access.log;

    location / {
        proxy_pass http://127.0.0.1:${CONSOLE_PORT};
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
