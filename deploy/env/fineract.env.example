# Malipopay core banking environment template.
#
# Copy to .env.<environment>, fill every value, then encrypt with SOPS. Only the .enc file
# is ever committed. Generate secrets with `openssl rand -base64 32`, never by hand.
#
#   cp fineract.env.example .env.uat
#   $EDITOR .env.uat
#   sops --encrypt --input-type dotenv --output-type dotenv .env.uat > .env.uat.enc
#   shred -u .env.uat        # on macOS: rm -P .env.uat
#
# Nothing in this file may carry a real password, hostname or IP address when committed.

# ---------------------------------------------------------------------------------------
# Images. Both are pinned. See docs/malipopay/runbooks/upgrade.md before changing either.
# ---------------------------------------------------------------------------------------
# Built by .github/workflows/malipopay-docker-build.yml from the tag named in
# deploy/UPSTREAM_VERSION. Apache publishes no Docker image for releases 1.13.0 and later,
# and apache/fineract:latest is the develop branch, so we build and pin our own.
FINERACT_IMAGE=lockwoodtech/malipopay-fineract:1.15.0-mp.1
POSTGRES_IMAGE_TAG=18.3
# openmf/web-app, pinned to a dated dev tag. "dev" moves daily; "master" is stale.
CONSOLE_IMAGE_TAG=dev-3588dc6

# ---------------------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------------------
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=            # openssl rand -base64 32
FINERACT_TENANTS_DB_NAME=fineract_tenants
FINERACT_DEFAULT_TENANTDB_NAME=fineract_uat
FINERACT_HIKARI_USERNAME=fineract_app
FINERACT_HIKARI_PASSWORD=               # openssl rand -base64 32
FINERACT_HIKARI_MINIMUM_IDLE=3
FINERACT_HIKARI_MAXIMUM_POOL_SIZE=10

# ---------------------------------------------------------------------------------------
# Tenant
#
# One Fineract tenant per Malipopay environment, addressed by the Fineract-Platform-TenantId
# header on every API call. The timezone decides business dates, so it decides which day a
# transaction and the close-of-business run belong to. Keep it Dar es Salaam.
# ---------------------------------------------------------------------------------------
FINERACT_TENANT_IDENTIFIER=uat
FINERACT_TENANT_DESCRIPTION=Malipopay UAT
FINERACT_TENANT_TIMEZONE=Africa/Dar_es_Salaam
FINERACT_TENANT_MASTER_PASSWORD=        # openssl rand -base64 32; encrypts stored tenant credentials

# ---------------------------------------------------------------------------------------
# Instance mode
#
# A single instance does everything. When a read replica is added, that instance sets
# READ true, WRITE false, both batch flags false, and FINERACT_LIQUIBASE_ENABLED false:
# only one instance may migrate the schema.
# ---------------------------------------------------------------------------------------
FINERACT_NODE_ID=1
FINERACT_MODE_READ_ENABLED=true
FINERACT_MODE_WRITE_ENABLED=true
FINERACT_MODE_BATCH_MANAGER_ENABLED=true
FINERACT_MODE_BATCH_WORKER_ENABLED=true
FINERACT_LIQUIBASE_ENABLED=true
FINERACT_JOB_LOAN_COB_ENABLED=true

# ---------------------------------------------------------------------------------------
# Network exposure
#
# Fineract binds to loopback on the droplet. NGINX terminates TLS and is the only route in,
# behind an IP allowlist. Publishing 0.0.0.0 here would put an unauthenticated-by-default
# banking API on the public internet.
# ---------------------------------------------------------------------------------------
FINERACT_BIND_ADDRESS=127.0.0.1
FINERACT_HOST_PORT=8080
CONSOLE_BIND_ADDRESS=127.0.0.1
CONSOLE_HOST_PORT=8081
CBS_PUBLIC_URL=                         # https://<fineract host>, used by the console browser client
CBS_CONSOLE_ORIGIN=                     # https://<console host>, the only allowed CORS origin
SPRINGDOC_SWAGGER_UI_ENABLED=false
SPRINGDOC_API_DOCS_ENABLED=false

# ---------------------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------------------
# Basic auth stays on: the only caller is the banking service, over the private network,
# as a dedicated least-privilege Fineract user. Customer identity never reaches Fineract.
FINERACT_SECURITY_BASICAUTH_ENABLED=true
FINERACT_SECURITY_OAUTH_ENABLED=false
FINERACT_SECURITY_2FA_ENABLED=false

# The service account the banking middleware authenticates as. Created by
# docs/malipopay/runbooks/service-account.md, not by this file. Recorded here so release.sh
# can run its smoke test.
CBS_SERVICE_USERNAME=
CBS_SERVICE_PASSWORD=

# ---------------------------------------------------------------------------------------
# JVM
# ---------------------------------------------------------------------------------------
# Percentage of the container limit the heap may use. 70 on a droplet where Fineract and
# PostgreSQL share the host.
JVM_MAX_RAM_PERCENTAGE=70

# ---------------------------------------------------------------------------------------
# External business events. Phase 4 only. See docker-compose.events.yml.
# ---------------------------------------------------------------------------------------
FINERACT_EXTERNAL_EVENTS_ENABLED=false
FINERACT_EXTERNAL_EVENTS_PRODUCER_JMS_ENABLED=false
ACTIVEMQ_USERNAME=
ACTIVEMQ_PASSWORD=
FINERACT_EVENTS_QUEUE=malipopay.cbs.events

# ---------------------------------------------------------------------------------------
# Backups
# ---------------------------------------------------------------------------------------
# rclone remote configured on the host, pointing at the Cloudflare R2 bucket. The rclone
# config lives at /etc/malipopay-cbs/rclone.conf on the droplet, not in this repo.
BACKUP_RCLONE_REMOTE=
BACKUP_RETENTION_DAYS=30
